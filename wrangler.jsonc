{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "functionary-dev",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "functionary.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.functionary.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
